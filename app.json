{
  "expo": {
    "name": "Acadence",
    "slug": "QR-ATT",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/android-icon-monochrome.png",
    "scheme": "qr-attendance",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#07142B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.xaconic.QRATT"
    },
    "androidNavigationBar": {
      "backgroundColor": "#07142B",
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Acadence to save event QR codes to your photo library.",
          "savePhotosPermission": "Allow Acadence to save event QR codes to your photo library.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-branding.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#07142B"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c3f34f28-2042-4a25-a9e7-b0c60900d18b"
      }
    },
    "owner": "xaconic"
  }
}
